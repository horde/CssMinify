{
    "name": "horde/cssminify",
    "description": "CSS minification library",
    "type": "library",
    "homepage": "https://www.horde.org",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        }
    ],
    "time": "2026-06-27",
    "repositories": [],
    "require": {
        "php": "^8",
        "horde/css_parser": "^2.0.0-beta4 || dev-FRAMEWORK_6_0",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/log": "^3 || dev-FRAMEWORK_6_0",
        "horde/url": "^3 || dev-FRAMEWORK_6_0",
        "psr/log": "^3"
    },
    "require-dev": {},
    "suggest": {},
    "autoload": {
        "psr-0": {
            "Horde_CssMinify": "lib/"
        },
        "psr-4": {
            "Horde\\CssMinify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\CssMinify\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "2.x-dev"
        }
    }
